@baseUrl = http://localhost:8080
@accessToken = eyJhbGciOiJIUzUxMiJ9..Y1cAxrRThIIIlen8Bp-YBbhKXhL0HzkorjS0UEOpZ5pWop3CojVs-O93buXzOkTcPFFIhE4HNGWtUA3X91sH7Q
@conversationId = c6e2c021-73d2-4f66-bac3-8bd0b429fc29

### Create conversation
POST {{baseUrl}}/api/v1/conversations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Frontend interview preparation"
}

### List conversations
GET {{baseUrl}}/api/v1/conversations
Authorization: Bearer {{accessToken}}

### Get conversation with messages
GET {{baseUrl}}/api/v1/conversations/{{conversationId}}
Authorization: Bearer {{accessToken}}

### Send message
POST {{baseUrl}}/api/v1/conversations/{{conversationId}}/messages
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "For a TypeScript senior, what will you expect this candidate to master?"
}

### Delete conversation
DELETE {{baseUrl}}/api/v1/conversations/{{conversationId}}
Authorization: Bearer {{accessToken}}
